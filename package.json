{
  "name": "@cavi-ai/ableton-mcp",
  "version": "0.1.0",
  "description": "Local-first Ableton Live MCP server, CLI, and Remote Script bridge",
  "keywords": [
    "ableton",
    "ableton-live",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "remote-script",
    "midi",
    "music-production",
    "nks",
    "cli"
  ],
  "license": "MIT",
  "author": "CAVI AI",
  "homepage": "https://github.com/cavi-ai/ableton-mcp#readme",
  "bugs": {
    "url": "https://github.com/cavi-ai/ableton-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/ableton-mcp.git"
  },
  "type": "module",
  "bin": {
    "ableton-mcp": "apps/ableton-mcp/src/cli.mjs"
  },
  "files": [
    "apps/ableton-mcp/src",
    "ableton/Remote Scripts/CaviMcpBridge/__init__.py",
    "ableton/Remote Scripts/CaviMcpBridge/bridge.py",
    "ableton/Remote Scripts/CaviMcpBridge/capabilities.json",
    "ableton/Remote Scripts/CaviMcpBridge/protocol.py",
    "packages/nks-pipeline/src/catalog.mjs",
    "LICENSE",
    "README.md",
    "docs/ableton-mcp/source/pages"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @cavi-ai/ableton-mcp-core start",
    "cli": "node apps/ableton-mcp/src/cli.mjs",
    "catalog:inventory": "node packages/nks-pipeline/scripts/inventory-catalog.mjs",
    "test": "npm --workspace @cavi-ai/nks-pipeline test && npm --workspace @cavi-ai/ableton-mcp-core test && python3 -m unittest discover -s 'ableton/Remote Scripts/CaviMcpBridge/tests' && npm run docs:test",
    "test:mcp": "npm --workspace @cavi-ai/ableton-mcp-core test",
    "test:pipeline": "npm --workspace @cavi-ai/nks-pipeline test",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:verify": "node scripts/docs/verify.mjs",
    "docs:test": "node --test scripts/docs/*.test.mjs",
    "docs:tools": "node scripts/docs/tools-reference.mjs",
    "verify:package": "node scripts/package-e2e.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
